# Android 打包与分发
# 用法（在 android/ 目录下）：
#   bundle exec fastlane build_release   # 本地出签名 APK + AAB
#   bundle exec fastlane distribute      # 构建并分发到 Firebase App Distribution

default_platform(:android)

# Firebase 控制台里本应用的 App ID（与 google-services.json 一致）
FIREBASE_APP_ID = "1:420535907720:android:9b80fed2ce6ed6df8e363d"

platform :android do
  desc "构建签名 Release APK 和 AAB（输出在 app/build/outputs/ 下）"
  lane :build_release do
    gradle(task: "assemble", build_type: "Release") # APK
    gradle(task: "bundle", build_type: "Release")   # AAB（上传 Play 用）
    UI.success("APK:  app/build/outputs/apk/release/app-release.apk")
    UI.success("AAB:  app/build/outputs/bundle/release/app-release.aab")
  end

  desc "构建并分发到 Firebase App Distribution（需 FIREBASE_TOKEN，testers 组）"
  lane :distribute do |options|
    gradle(task: "assemble", build_type: "Release")

    release_notes = options[:notes] || ENV["RELEASE_NOTES"] ||
                    "ToSleep 测试版本 #{Time.now.strftime('%Y-%m-%d %H:%M')}"

    firebase_app_distribution(
      app: FIREBASE_APP_ID,
      groups: ENV["FIREBASE_GROUPS"] || "[VIP] Tester",
      release_notes: release_notes,
      firebase_cli_token: ENV["FIREBASE_TOKEN"]
    )
  end
end
